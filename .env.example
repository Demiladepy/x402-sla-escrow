# Copy to .env and fill in. .env is gitignored — never commit a key.

# Agent wallet, Celo mainnet. Generate with: npm run agent:wallet
# This is a hot wallet the settler signs with. Keep only what it needs to spend.
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

# Public URL of the ERC-8004 registration file. Must resolve before registering.
AGENT_URI=https://raw.githubusercontent.com/Demiladepy/x402-sla-escrow/main/agent.json

# Chainstack Celo nodes (preferred). Path carries the node key. Never commit.
# https://docs.chainstack.com/docs/celo-tooling
CHAINSTACK_CELO_RPC_URL=
CHAINSTACK_SEPOLIA_RPC_URL=

# Fallback RPC if Chainstack is unset. A Chainstack URL here still counts.
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Cencori AI Gateway. Formats the public /api/rate quote. Timeout 450ms, then
# the published mid is served so the 800ms SLA still holds.
# https://cencori.com/docs/hackathons/celo-agents
CENCORI_API_KEY=
# CENCORI_BASE_URL=https://api.cencori.com/v1
# CENCORI_MODEL=gpt-4o
# CENCORI_AGENT_ID=

# Optional: pay gas in an ERC-20 instead of CELO (Celo fee abstraction).
# Use the ADAPTER address for tokens that are not 18 decimals, not the token
# address — adapters normalise 6-decimal tokens to the 18 decimals gas pricing
# expects. Celo mainnet:
#   USAT  adapter 0x0357EE22278c922e1D36cFe6b899269b161880C4
#         token   0xD2ab3C9A02DBBAB236BfEC45D1d755DF4267F771
#   USDC  adapter 0x2F25deB3848C207fc8E0c34035B3Ba7fC157602B
#         token   0xcebA9300f2b948710d2653dD7B07f33A8B32118C
#   USDT  adapter 0x0E2A3e05bc9A16F5292A6170456A710cb89C6f72
#   USDm  0x765DE816845861e75A25fCA122bb6898B8B1282a (18 decimals, use directly)
#   NGNm  0xE2702Bd97ee33c88c8f6f92DA3B733608aa76F71 (18 decimals, use directly)
FEE_CURRENCY=

# Settlement asset for the escrow deploy. Celo mainnet, pick one:
#   USAT  0xD2ab3C9A02DBBAB236BfEC45D1d755DF4267F771  (6 decimals, Self/Google faucet)
#   cUSD  0x765DE816845861e75A25fCA122bb6898B8B1282a  (18 decimals)
# Set deliberately per network — Deploy.s.sol reads this rather than hardcoding.
TOKEN=

# Challenge arbiter. Defaults to the deployer when unset.
ARBITER=

# Attribution, ERC-8021. Both are encoded into every settlement's calldata, in
# the order below. Codes must match /^[a-z0-9_]{1,32}$/ — a Celo Builders *claim*
# code (uppercase, dashed) is not a tag and will be rejected rather than encoded.
#
# On Celo mainnet the settler refuses to run when both are empty: the tag lives
# in calldata, so it cannot be added after a send and there is no backfill.
ATTRIBUTION_CODE=x402_sla
# Returned by Celo Builders registration (celo_ + 12 hex).
CELO_ATTRIBUTION_TAG=

# Buyer that paid for calls. Required for ERC-8004 giveFeedback — the owner
# cannot rate itself. Generate with: npm run buyer:wallet
# If unset, drop "reputation" from agent.json rather than lie.
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# Optional: reuse a Sepolia escrow already deployed by the rehearsal.
# ESCROW=0x...

# Submission extras (hack:register / hack:publish)
# OWN_CONTRACTS=
# SOCIAL_LINK=
# Existing Vercel deployment, no trailing slash.
# APP_DOMAIN=https://web-one-drab-31.vercel.app

# Public dashboard (web/ build-time)
# VITE_SELLER_URL=https://seller.example
# VITE_MAINNET_ESCROW=
# VITE_MAINNET_DEPLOY_TX=
# VITE_MAINNET_SETTLE_TX=
