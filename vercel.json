{
  "buildCommand": "npm run build --workspace web",
  "outputDirectory": "web/dist",
  "framework": null,
  "functions": {
    "api/rate.ts": { "maxDuration": 10 },
    "web/api/rate.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/rate", "destination": "/api/rate" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
